# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas el archivo ".env" real (con secretos reales) al repositorio.

# Ruta de la base de datos SQLite (relativa a la carpeta de trabajo del
# contenedor, /app).
DATABASE_URL=sqlite:///data/app.db

# Llave secreta usada para firmar y verificar los tokens JWT.
# Genera una propia y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esta-llave-por-una-generada-aleatoriamente

# Minutos de vigencia del token de acceso antes de expirar (sesión segura
# con tiempo de expiración, como pide la práctica).
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Activa (true) o desactiva (false) el modo debug de Flask.
# Usa "false" si llegaras a desplegar esto en un entorno público.
FLASK_DEBUG=true
