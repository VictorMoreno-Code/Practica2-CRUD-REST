# ---------------------------------------------------------------------------
# Archivo de EJEMPLO de variables de entorno.
#
# El proyecto arranca sin necesidad de este archivo: "docker compose up
# --build" funciona tal cual en un equipo limpio usando valores por defecto
# seguros (ver docker-compose.yml y app.py).
#
# Crea tu propio ".env" (copiando este archivo) SOLO si quieres fijar tus
# propios valores. El ".env" real nunca se sube al repositorio: está listado
# en .gitignore y en .dockerignore.
#
#   Linux / macOS : cp .env.example .env
#   Windows (PS)  : copy .env.example .env
# ---------------------------------------------------------------------------

# Cadena de conexión de la base de datos.
# Si se deja vacía, app.py usa automáticamente la ruta ABSOLUTA
# /app/data/app.db dentro del contenedor, que es la carpeta persistida por
# el volumen "./data:/app/data" de docker-compose.yml.
DATABASE_URL=

# Llave secreta usada para FIRMAR y VERIFICAR los tokens JWT.
# Si se deja vacía, app.py genera una llave aleatoria en cada arranque
# (las sesiones abiertas dejan de ser válidas al reiniciar el contenedor).
# Genera la tuya, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Minutos de vigencia del token de acceso antes de expirar (sesión segura
# con tiempo de expiración, como pide la práctica).
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Modo debug de Flask: "true" solo para desarrollo local.
FLASK_DEBUG=false
